.DS_Store

# 测试数据不入库；交付说明文档需要入库
docs/*
!docs/众源感知AI解译工具说明.md
.idea/

# 构建产物不入库；yolo11n.pt 权重入库（CI 导出 ONNX 用）
models/*.onnx
*.pt
!yolo11n.pt

# Python
__pycache__/
*.pyc
.venv/
venv/
build/
dist/
*.spec.bak
.pytest_cache/

# 本地输出
output/
preview/
result_*.shp
result_*.shx
result_*.dbf
result_*.prj
result_*.gdb/

# 项目记忆（本地）
.workbuddy/

# 临时构建目录（沙箱限制无法删除时使用新 distpath）
dist_*/
build_*/

# 预览构建产物（由 build_preview.py 生成）
ui-redesign/preview.html
